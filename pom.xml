<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>io.github.bagus-full-stack</groupId>
  <artifactId>audit-spring-boot-starter-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Audit Spring Boot Starter — Parent</name>
  <description>Production-ready audit library for Spring Boot 3 microservices</description>
  <url>https://github.com/bagus-full-stack/bagus-audit-spring-boot-starter</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>assami</id>
      <name>Assami Baga</name>
      <email>bagaassami009@gmail.com</email>
      <url>https://assami.dev</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/bagus-full-stack/bagus-audit-spring-boot-starter.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/bagus-full-stack/bagus-audit-spring-boot-starter.git</developerConnection>
    <url>https://github.com/bagus-full-stack/bagus-audit-spring-boot-starter</url>
  </scm>

  <modules>
    <module>autoconfigure</module>
    <module>starter</module>
    <module>starter-jpa</module>
    <module>starter-ai</module>
    <module>sample</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <!-- Boot 3.3.4 manages 1.19.x, which cannot talk to Docker Engine 29 (min API 1.44) -->
    <testcontainers.version>1.21.4</testcontainers.version>
    <!-- Spring AI 1.0.x starts on Boot 3.3 (checked), although its own docs target 3.4 -->
    <spring-ai.version>1.0.3</spring-ai.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Internal modules -->
      <dependency>
        <groupId>io.github.bagus-full-stack</groupId>
        <artifactId>audit-autoconfigure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.bagus-full-stack</groupId>
        <artifactId>audit-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.bagus-full-stack</groupId>
        <artifactId>audit-starter-jpa</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.bagus-full-stack</groupId>
        <artifactId>audit-starter-ai</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
                <requireJavaVersion><version>[17,)</version></requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Maven Central release: ./mvnw -P release deploy (see the Releasing section of README.md). Needs a GPG key and Central Portal credentials. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <configuration>
              <doclint>none</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
                <configuration>
                  <!-- Passphrase comes from the GPG_PASSPHRASE environment variable (set in the release workflow). -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.8.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- Upload only; publish the deployment by hand in the Central Portal after checking it. -->
              <autoPublish>false</autoPublish>
              <excludeArtifacts>
                <artifact>audit-sample</artifact>
              </excludeArtifacts>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
