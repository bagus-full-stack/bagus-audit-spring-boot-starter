        { "requestParam": "client_id", "match": "other-app",
          "claims": { "sub": "other-app", "aud": ["billing-api"], "roles": ["AUDIT_ADMIN"], "tenant_id": "acme" } }
      ]
    },
    {
      "issuerId": "auth0",
