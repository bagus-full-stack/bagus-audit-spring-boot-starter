        { "requestParam": "client_id", "match": "reader-globex",
          "claims": { "sub": "reader-globex", "aud": ["audit-api"], "https://app.example.com/roles": ["AUDIT_READ"], "https://app.example.com/tenant": "globex" } },
        { "requestParam": "client_id", "match": "other-app",
